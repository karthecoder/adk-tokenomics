# Agent Nexus Model Configuration
# Allowed models:
#   - publishers/google/models/gemini-3.5-flash
#   - publishers/google/models/gemini-3.6-flash
#   - publishers/google/models/gemini-3.7-flash
#   - claude-sonnet-5
DEMO_MODEL_NAME=publishers/google/models/gemini-3.5-flash

# Reasoning / Thinking Budget in tokens:
# 0 = Off, 1024 = Low, 4096 = High, -1 = Dynamic
THINKING_BUDGET=4096

# Max Output Token Limit (e.g., 1024, 2048, 4096, 8192, 16384):
MAX_OUTPUT_TOKENS=8192

# GCP & BigQuery Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Anthropic API Key (Required only if using Claude Sonnet 5 model)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
